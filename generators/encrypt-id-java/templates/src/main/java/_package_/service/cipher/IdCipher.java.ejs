package <%= packageName %>.service.cipher;

import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.List;
import java.util.regex.Pattern;
import javax.crypto.Cipher;
import javax.crypto.spec.IvParameterSpec;
import javax.crypto.spec.SecretKeySpec;
import org.springframework.security.crypto.codec.Hex;
import tech.jhipster.service.filter.LongFilter;

/**
 * Encrypts and decrypts the database ids of an entity.
 *
 * <p>Every entity uses its own initialization vector, so the same database id results in a different
 * encrypted id per entity. The encrypted value carries a magic number, which makes it possible to
 * detect a tampered or foreign id while decrypting.
 *
 * <p>An encrypted id is exactly one cipher block, written as 32 lower case hex digits, and nothing else is
 * decrypted. This is what rules out a padding oracle: the only block in front of the decrypted one is the
 * fixed initialization vector, so a caller controls nothing that is combined with the decrypted block. It
 * also keeps one canonical encrypted id per database id. As defence in depth, every invalid id is rejected
 * with the same {@link InvalidIdException}, without a cause, so a caller cannot tell a padding error from any
 * other invalid id either.
 *
 * <p>The ciphers are held per thread, because a {@link Cipher} is not thread safe. A failed
 * {@code doFinal} may leave its cipher in an undefined state, so the cipher of the thread is
 * discarded whenever an operation fails and the next call starts with a freshly initialized one.
 */
public class IdCipher {

    private static final long MAGIC = 0x00deadbeefcafe00L;

    private static final int PAYLOAD_LENGTH = 15;

    private static final int MAGIC_OFFSET = 8;

    private static final Pattern ENCRYPTED_ID = Pattern.compile("[0-9a-f]{32}");

    private final IvParameterSpec ivParameterSpec;

    private final SecretKeySpec secretKeySpec;

    private final ThreadLocal<Cipher> encryptCipher = ThreadLocal.withInitial(() -> createCipher(Cipher.ENCRYPT_MODE));

    private final ThreadLocal<Cipher> decryptCipher = ThreadLocal.withInitial(() -> createCipher(Cipher.DECRYPT_MODE));

    public IdCipher(String keyString, String ivString) {
        try {
            byte[] iv = MessageDigest.getInstance("MD5").digest(ivString.getBytes(StandardCharsets.UTF_8));
            this.ivParameterSpec = new IvParameterSpec(iv);

            byte[] key = MessageDigest.getInstance("SHA-256").digest(keyString.getBytes(StandardCharsets.UTF_8));
            this.secretKeySpec = new SecretKeySpec(key, "AES");
        } catch (Exception e) {
            throw new IdCipherException(e.getMessage(), e);
        }
    }

    /**
     * Encrypts a database id.
     *
     * @param id the database id, may be {@code null}
     * @return the encrypted id or {@code null}
     */
    public String encrypt(Long id) {
        if (id == null) {
            return null;
        }

        try {
            byte[] decrypted = new byte[PAYLOAD_LENGTH];
            setLong(decrypted, id);
            setMagic(decrypted);

            byte[] encrypted = encryptCipher.get().doFinal(decrypted);
            return new String(Hex.encode(encrypted));
        } catch (Exception e) {
            encryptCipher.remove();
            throw new IdCipherException(e.getMessage(), e);
        }
    }

    /**
     * Decrypts an encrypted id.
     *
     * @param id the encrypted id, may be {@code null}
     * @return the database id or {@code null}
     * @throws InvalidIdException if the id was not encrypted by this cipher
     */
    public Long decrypt(String id) {
        if (id == null) {
            return null;
        }

        if (!ENCRYPTED_ID.matcher(id).matches()) {
            throw new InvalidIdException();
        }

        // Created outside of the try, a cipher that cannot be created is a server error and not an invalid id.
        Cipher cipher = decryptCipher.get();
        byte[] decrypted;
        try {
            decrypted = cipher.doFinal(Hex.decode(id));
        } catch (Exception e) {
            decryptCipher.remove();
            // The cause is dropped on purpose, a padding error must look like any other invalid id.
            throw new InvalidIdException();
        }

        if (decrypted.length != PAYLOAD_LENGTH || getMagic(decrypted) != MAGIC) {
            throw new InvalidIdException();
        }

        return getLong(decrypted);
    }

    /**
     * Decrypts a filter on encrypted ids into a filter on the database ids.
     *
     * <p>The cipher of an entity exposes this as {@code decryptFilter}, typed to the filters on its own ids, so the
     * compiler checks that a filter is decrypted with the cipher of the entity its ids belong to.
<%_ if (encryptIdRangeFilter) { _%>
     * The values of the range operators are decrypted as well, so a range compares the database ids.
<%_ } else { _%>
     * A range operator is never set, an encrypted id has no order.
<%_ } _%>
     *
     * @param filter the filter on encrypted ids, may be {@code null}
     * @return the filter on database ids or {@code null}
     * @throws InvalidIdException if one of the ids was not encrypted by this cipher
     */
    protected final LongFilter toLongFilter(EncryptedIdFilter<?> filter) {
        if (filter == null) {
            return null;
        }

        LongFilter decrypted = new LongFilter();
        decrypted.setEquals(decryptValue(filter.getEquals()));
        decrypted.setNotEquals(decryptValue(filter.getNotEquals()));
        decrypted.setIn(decryptValues(filter.getIn()));
        decrypted.setNotIn(decryptValues(filter.getNotIn()));
        decrypted.setSpecified(filter.getSpecified());
<%_ if (encryptIdRangeFilter) { _%>
        decrypted.setGreaterThan(decryptValue(filter.getGreaterThan()));
        decrypted.setGreaterThanOrEqual(decryptValue(filter.getGreaterThanOrEqual()));
        decrypted.setLessThan(decryptValue(filter.getLessThan()));
        decrypted.setLessThanOrEqual(decryptValue(filter.getLessThanOrEqual()));
<%_ } _%>
        return decrypted;
    }

    // An empty request parameter means "no value", exactly like for a LongFilter.
    private Long decryptValue(String id) {
        return id == null || id.isEmpty() ? null : decrypt(id);
    }

    private List<Long> decryptValues(List<String> ids) {
        return ids == null ? null : ids.stream().filter(id -> id != null && !id.isEmpty()).map(this::decrypt).toList();
    }

    private Cipher createCipher(int mode) {
        try {
            Cipher cipher = Cipher.getInstance("AES/CBC/PKCS5Padding");
            cipher.init(mode, secretKeySpec, ivParameterSpec);
            return cipher;
        } catch (Exception e) {
            throw new IdCipherException(e.getMessage(), e);
        }
    }

    private void setLong(byte[] bytes, long value) {
        for (int index = 0; index < 8; index++) {
            bytes[index] = (byte) (value >> (56 - 8 * index));
        }
    }

    private void setMagic(byte[] bytes) {
        for (int index = 0; index < PAYLOAD_LENGTH - MAGIC_OFFSET; index++) {
            bytes[MAGIC_OFFSET + index] = (byte) (MAGIC >> (48 - 8 * index));
        }
    }

    private long getLong(byte[] bytes) {
        long value = 0;
        for (int index = 0; index < 8; index++) {
            value <<= 8;
            value |= (long) bytes[index] & 0xff;
        }
        return value;
    }

    private long getMagic(byte[] bytes) {
        long value = 0;
        for (int index = 0; index < PAYLOAD_LENGTH - MAGIC_OFFSET; index++) {
            value <<= 8;
            value |= (long) bytes[MAGIC_OFFSET + index] & 0xff;
        }
        return value;
    }
}
